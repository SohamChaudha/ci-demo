pipeline{
  agent any
  enviroment {
    APP_ENV = 'staging'
  }
  
    stages {
      stage('Build'){
        options {
          retry(3)
        }
        
        steps {
          sh 'make build'
        }
      }
      stage('Test'){
        script{
          try {
            sh 'make test'
          }
          catch(exception e) {
            currentBuild.result = 'UNSTABLE'
          }
        }
      } 
    }
  }
